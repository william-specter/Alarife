APP_NAME=Alarife
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 15+
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alarife
DB_USERNAME=alarife
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public

# Production: switch to redis for both.
QUEUE_CONNECTION=database
CACHE_STORE=database
# Optional Redis (not required for broadcasts, queues or sessions).
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@alarife.test"
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp

# Laravel Reverb is the default broadcaster; Redis is not required.
REVERB_APP_ID=774321
REVERB_APP_KEY=alarife-dev-key
REVERB_APP_SECRET=alarife-dev-secret
REVERB_HOST=localhost
REVERB_SERVER_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
